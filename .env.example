# PostgreSQL connection string (Neon / Vercel Postgres / Supabase / any Postgres).
# Leave unset locally to use the embedded PGlite database in ./.pglite
DATABASE_URL=

# Email (optional). Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465, SMTP_USER=your Gmail, SMTP_PASS=a Google App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# or: RESEND_API_KEY=
EMAIL_FROM=
# Owner inbox for new-registration and sign-in notices (empty = off); set ADMIN_NOTIFY_LOGINS=false to stop sign-in notices
ADMIN_EMAIL=
ADMIN_NOTIFY_LOGINS=true
